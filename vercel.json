{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/sync-selftest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/sync-snapshot",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/diag/passkey-census",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
